DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pambala?schema=public"
JWT_SECRET="change-this-to-a-strong-secret"
PORT=3001
UPLOAD_DIR="./uploads"
# Cloudinary (opção recomendada) - https://cloudinary.com, conta gratuita (Dashboard -> Product Environments)
# Upload por Basic Auth: cloud_name + api_key + api_secret.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Agente de tradução (translation_agent) — opcional; necessário para gerar traduções
OPENAI_API_KEY=""            # OpenRouter API key (https://openrouter.ai/settings/keys)
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_MODEL="openai/gpt-4.1-nano"  # qualquer modelo OpenRouter (ex: anthropic/claude-sonnet-4, google/gemini-2.5-flash)
