generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  phone     String?   @unique
  password  String
  name      String
  avatar    String?
  googleId  String?   @unique
  facebookId String?  @unique
  linkedinId String?  @unique
  aiValidationConsent Boolean @default(false)
  tokenVersion Int    @default(0)
  role      String    @default("CLIENT")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  store     Store?
  cart      Cart?
  orders    Order[]
  reviews   Review[]
  addresses Address[]
  wallet    Wallet?
  roles     UserRole[]
  disputeMessages OrderDisputeMessage[]
  disputeReads OrderDisputeRead[]
  issuedInvoices Invoice[]
}

model Role {
  id              String               @id @default(cuid())
  key             String               @unique
  name            String
  description     String?
  isSystem        Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  responsibilities RoleResponsibility[]
  users           UserRole[]
}

model Responsibility {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  roles       RoleResponsibility[]
}

model RoleResponsibility {
  roleId           String
  role             Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  responsibilityId String
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@id([roleId, responsibilityId])
}

model UserRole {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
}

model Store {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logo        String?
  banner      String?
  phone       String?
  isVerified  Boolean   @default(false)
  rating      Float     @default(0)
  views       Int       @default(0)
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  products    Product[]
  reviews     Review[]
  translations StoreTranslation[]
  province    String?
  district    String?
  latitude    Float?
  longitude   Float?
  paymentMethods String  @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  categories  StoreCategory[]
  fiscalProfile StoreFiscalProfile?
  invoiceSeries InvoiceSeries[]
  invoices      Invoice[]
}

model StoreCategory {
  storeId    String
  categoryId String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([storeId, categoryId])
  @@index([categoryId])
}

model StoreTranslation {
  id       String  @id @default(cuid())
  storeId  String
  store    Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  locale   String
  province String?
  district String?
  updatedAt DateTime @updatedAt

  @@unique([storeId, locale])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  icon      String?
  image     String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  translations CategoryTranslation[]
  products  Product[]
  storeCategories StoreCategory[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     String
  name       String?
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, locale])
}

model Product {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String?
  price        Float
  comparePrice Float?
  images       String      @default("[]")
  condition    String      @default("NEW")
  stock        Int         @default(1)
  isActive     Boolean     @default(true)
  views        Int         @default(0)
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id])
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  translations ProductTranslation[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reviews      Review[]
  invoiceLines InvoiceLine[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([categoryId])
  @@index([storeId])
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      String
  name        String?
  description String?
  updatedAt   DateTime @updatedAt

  @@unique([productId, locale])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  status           String      @default("PENDING")
  total            Float
  shippingFee      Float       @default(0)
  paymentMethod    String
  paymentStatus    String      @default("PENDING")
  paymentRef       String?
  paymentCode            String?
  receiptImage           String?
  receiptAttempts        Int         @default(0)
  transactionFingerprint String?
  paymentDetails         String?
  paymentHistory         String?
  validationStatus       String?
  validationResult       String?
  receiptJob             ReceiptQueue?
  shippingName           String
  shippingPhone          String
  shippingAddress        String
  shippingProvince       String
  shippingDistrict       String?
  notes                  String?
  carrierName            String?
  trackingCode           String?
  estimatedDelivery      String?
  shippedAt              DateTime?
  deliveredAt            DateTime?
  receivedAt             DateTime?
  userId                 String
  user                   User        @relation(fields: [userId], references: [id])
  items                  OrderItem[]
  dispute                OrderDispute?
  orderEvents            OrderEvent[]
  invoices               Invoice[]
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([userId])
  @@index([transactionFingerprint])
}

model OrderEvent {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind                String
  from                String?
  to                  String?
  note                String?
  actorRole           String?
  actorUserId         String?
  metadata            String?
  createdAt           DateTime @default(now())

  @@index([orderId, createdAt])
}

model ReceiptQueue {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  lastError   String?
  result      String?
  enqueuedAt  DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  storeId   String
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@unique([userId, storeId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  province  String
  district  String?
  address   String
  isDefault Boolean @default(false)
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  balance      Float         @default(0)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  type        String
  amount      Float
  description String?
  createdAt   DateTime @default(now())
}

model OrderDispute {
  id        String                @id @default(cuid())
  orderId   String                @unique
  order     Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String                @default("OPEN") // OPEN, RESOLVED, CLOSED
  reason    String                @default("PAYMENT_ISSUE")
  messages  OrderDisputeMessage[]
  reads     OrderDisputeRead[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model OrderDisputeMessage {
  id         String       @id @default(cuid())
  disputeId  String
  dispute    OrderDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole String       // CLIENT, SELLER, ADMIN, SYSTEM
  content    String
  attachment String?
  createdAt  DateTime     @default(now())

  @@index([disputeId])
}

model OrderDisputeRead {
  id         String        @id @default(cuid())
  disputeId  String
  dispute    OrderDispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime      @default(now())
  createdAt  DateTime      @default(now())

  @@unique([disputeId, userId])
}

// ---------------------------------------------------------------------------
// Módulo de Faturação (Regime Jurídico das Faturas – Decreto Presidencial 71/25)
// ---------------------------------------------------------------------------

// Configuração fiscal da plataforma (linha única, id = "global").
// Identificação do software certificado + credenciais de comunicação com a AGT.
model FiscalSettings {
  id                  String    @id @default("global")
  softwareName        String    @default("Pambala")
  softwareVersion     String    @default("1.0.0")
  softwareProvider    String    @default("Pambala")
  certificationNumber String?   // nº de certificação AGT (ex.: FE/323/AGT/2026)
  certificationDate   DateTime?
  hashAlgorithm       String    @default("sha256")
  hashSecret          String    @default("pambala-dev-secret")
  agtBaseUrl          String?   // endpoint da API da AGT (vazio = modo desenvolvimento)
  agtApiToken         String?
  timezone            String    @default("Africa/Luanda")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// Perfil fiscal de cada loja: cada loja é um emitente fiscal próprio.
model StoreFiscalProfile {
  id                     String    @id @default(cuid())
  storeId                String    @unique
  store                  Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nif                    String    // Número de Identificação Fiscal
  legalName              String    // denominação social
  address                String    // endereço completo
  province               String
  district               String?
  industryCode           String?   // CAE
  vatRegime              String    @default("GERAL") // GERAL | SIMPLIFICADO | EXCLUIDO | ISENTO
  establishmentRegistered Boolean  @default(false) // registo do estabelecimento na AGT
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  invoices               Invoice[]
}

// Série de faturação autorizada (numeração inicia em 1 e reinicia por ano civil;
// máx. 50 séries por estabelecimento/tipologia fiscal).
model InvoiceSeries {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  documentType   String    // FT | NC | ND
  prefix         String    // ex.: "A", "FT"
  year           Int       // ano civil da série
  status         String    @default("OPEN") // OPEN | CLOSED | CANCELLED
  nextNumber     Int       @default(1)      // próximo número a atribuir (alocação atómica)
  lastNumberUsed Int?
  validFrom      DateTime  @default(now())
  validUntil     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoices       Invoice[]

  @@unique([storeId, documentType, prefix, year])
  @@index([storeId])
}

// Documento fiscal emitido (imutável; montantes em cêntimos de AOA).
model Invoice {
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id])
  orderId           String?
  order             Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  seriesId          String
  series            InvoiceSeries @relation(fields: [seriesId], references: [id])
  fiscalProfileId   String?
  fiscalProfile     StoreFiscalProfile? @relation(fields: [fiscalProfileId], references: [id])
  documentType      String    // FT | NC | ND
  number            Int       // sequência dentro da série
  fullNumber        String    // ex.: "A/2026/1"
  status            String    @default("ACTIVE") // ACTIVE | VOID
  issueDate         DateTime  // data de emissão (momento relevante do imposto)
  dueDate           DateTime?
  emitterSnapshot   String    // JSON: denominação/NIF/endereço no momento da emissão
  customerSnapshot  String    // JSON: nome/NIF/endereço do cliente
  currency          String    @default("AOA")
  subtotal          Int       // cêntimos
  discountTotal     Int       @default(0)
  taxTotal          Int       @default(0)
  total             Int       @default(0)
  taxSummary        String    // JSON por taxa: [{rate, baseCents, taxCents}]
  hash              String    // código de validação AGT (SHA-256)
  qrData            String?   // payload do QR Code
  agtStatus         String    @default("PENDING") // PENDING | SENT | ACCEPTED | REJECTED | FAILED
  agtResponse       String?
  agtReference      String?
  originalInvoiceId String?
  originalInvoice   Invoice?  @relation("InvoiceCorrection", fields: [originalInvoiceId], references: [id])
  corrections       Invoice[] @relation("InvoiceCorrection")
  issuedByUserId    String?
  issuedBy          User?     @relation(fields: [issuedByUserId], references: [id])
  lines             InvoiceLine[]
  syncLogs          InvoiceCommunicationLog[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([seriesId, number])
  @@unique([orderId, documentType])
  @@index([storeId])
  @@index([orderId])
  @@index([issueDate])
}

model InvoiceLine {
  id             String      @id @default(cuid())
  invoiceId      String
  invoice        Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id])
  productName    String      // designação (snapshot)
  productSku     String?
  quantity       Int
  unitPrice      Int         // cêntimos
  discountAmount Int         @default(0)
  taxRate        Int         // 0 | 5 | 7 | 14 (%)
  taxAmount      Int         @default(0)
  lineSubtotal   Int         @default(0) // (qty*unitPrice) - discount
  lineTotal      Int         @default(0) // subtotal + tax
  reasonExempt   String?     // motivo da não liquidação do imposto (quando aplicável)
  originalLineId String?
  originalLine   InvoiceLine? @relation("LineCorrection", fields: [originalLineId], references: [id])
  corrections    InvoiceLine[] @relation("LineCorrection")
  createdAt      DateTime    @default(now())

  @@index([invoiceId])
}

// Trilho de comunicação com a AGT (retry + auditoria).
model InvoiceCommunicationLog {
  id              String    @id @default(cuid())
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  attempt         Int       @default(1)
  status          String    // PENDING | SENT | ACCEPTED | REJECTED | FAILED
  requestPayload  String?   // payload SAF-T/JSON enviado
  responsePayload String?
  httpStatus      Int?
  error           String?
  sentAt          DateTime  @default(now())
  nextRetryAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([invoiceId])
  @@index([status])
}

